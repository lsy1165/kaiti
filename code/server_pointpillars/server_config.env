# Shared config for server-side PointPillars reproduction.

# Project root on the Linux server. Override before running if needed:
#   export PROJECT_ROOT=/path/to/kaiti
PROJECT_ROOT="${PROJECT_ROOT:-$PWD}"

# Conda environment name.
CONDA_ENV_NAME="${CONDA_ENV_NAME:-kaiti3d}"

# OpenPCDet checkout location.
OPENPCDET_DIR="${OPENPCDET_DIR:-$PROJECT_ROOT/external/OpenPCDet}"

# KITTI data prepared by this project.
KITTI_SRC="${KITTI_SRC:-$PROJECT_ROOT/code/data/stage02_mono3d_detection/kitti}"

# PointPillars config inside OpenPCDet.
POINTPILLAR_CFG="${POINTPILLAR_CFG:-tools/cfgs/kitti_models/pointpillar.yaml}"

# Optional pretrained checkpoint. Put the file here or override CKPT_PATH.
CKPT_PATH="${CKPT_PATH:-$PROJECT_ROOT/code/models/openpcdet/pointpillar_kitti.pth}"

# Detection-demo assets. This route does not require full KITTI training data.
DEMO_DATA_DIR="${DEMO_DATA_DIR:-$PROJECT_ROOT/code/data/stage02_mono3d_detection/demo_samples}"
DEMO_SOURCE_FILE="${DEMO_SOURCE_FILE:-$DEMO_DATA_DIR/000008.bin}"
DEMO_DATA_PATH="${DEMO_DATA_PATH:-$DEMO_DATA_DIR}"
DEMO_OUTPUT_DIR="${DEMO_OUTPUT_DIR:-$PROJECT_ROOT/code/outputs/server_pointpillars_demo}"

# OpenPCDet official PointPillar KITTI checkpoint from the model zoo.
POINTPILLAR_GDRIVE_ID="${POINTPILLAR_GDRIVE_ID:-1wMxWTpU1qUoY3DsCH31WJmvJxcjFXKlm}"

# Small KITTI-format point cloud sample from MMDetection3D demo data.
DEMO_SAMPLE_URL="${DEMO_SAMPLE_URL:-https://raw.githubusercontent.com/open-mmlab/mmdetection3d/main/demo/data/kitti/000008.bin}"

# Demo sample id from KITTI training/velodyne if using full KITTI data.
SAMPLE_ID="${SAMPLE_ID:-000008}"

# Install defaults. Adjust to match server driver/CUDA if needed.
TORCH_INDEX_URL="${TORCH_INDEX_URL:-https://download.pytorch.org/whl/cu118}"
TORCH_PACKAGES="${TORCH_PACKAGES:-torch torchvision torchaudio}"
SPCONV_PACKAGE="${SPCONV_PACKAGE:-spconv-cu118}"
