# Shared config for server-side MVX-Net/MMDetection3D reproduction.

PROJECT_ROOT="${PROJECT_ROOT:-$PWD}"
CONDA_ENV_NAME="${CONDA_ENV_NAME:-base}"

MMDET3D_DIR="${MMDET3D_DIR:-$PROJECT_ROOT/external/mmdetection3d}"
MMDET3D_BRANCH="${MMDET3D_BRANCH:-dev-1.x}"

DEMO_DATA_DIR="${DEMO_DATA_DIR:-$PROJECT_ROOT/code/data/stage03_multimodal3d_detection/demo_samples}"
DEMO_IMAGE="${DEMO_IMAGE:-$DEMO_DATA_DIR/000008.png}"
DEMO_PCD="${DEMO_PCD:-$DEMO_DATA_DIR/000008.bin}"
DEMO_INFO="${DEMO_INFO:-$DEMO_DATA_DIR/000008.pkl}"

CKPT_DIR="${CKPT_DIR:-$PROJECT_ROOT/code/models/mmdetection3d}"
MVXNET_CKPT="${MVXNET_CKPT:-$CKPT_DIR/mvxnet_kitti.pth}"
MVXNET_CKPT_URL="${MVXNET_CKPT_URL:-https://download.openmmlab.com/mmdetection3d/v1.1.0_models/mvxnet/mvxnet_fpn_dv_second_secfpn_8xb2-80e_kitti-3d-3class/mvxnet_fpn_dv_second_secfpn_8xb2-80e_kitti-3d-3class-8963258a.pth}"

MVXNET_CONFIG="${MVXNET_CONFIG:-$MMDET3D_DIR/configs/mvxnet/mvxnet_fpn_dv_second_secfpn_8xb2-80e_kitti-3d-3class.py}"
OUTPUT_DIR="${OUTPUT_DIR:-$PROJECT_ROOT/code/outputs/stage03_mvxnet_demo}"

DEVICE="${DEVICE:-cuda:0}"
PRED_SCORE_THR="${PRED_SCORE_THR:-0.3}"
